<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.jiexi.mapper.PaperMapper">

    <select id="selectByTaskId" resultType="com.example.jiexi.entity.PaperEntity">
        select *
        from paper
        where task_id = #{taskId}
        order by id
    </select>

</mapper>
